# .clangd - LSP config for freestanding C
CompileFlags:
  Add:
    - -xc
    - -std=c11
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wconversion
    - -Wshadow
    - -Wundef
    - -ffreestanding
    - -nostdlib
    - -fno-stack-protector
    - --target=x86_64-unknown-linux-gnu
    - -I./src
  # Suppress warnings that don't apply to freestanding
  Remove:
    - -W*

Diagnostics:
  ClangTidy:
    Add: []
    Remove: []
  UnusedIncludes: None
  MissingIncludes: None

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true

Hover:
  ShowAKA: true

---
# Relax checks for test files
If:
  PathMatch: .*\.test\..*
Diagnostics:
  ClangTidy:
    Remove:
      - readability-magic-numbers
      - cppcoreguidelines-avoid-magic-numbers
