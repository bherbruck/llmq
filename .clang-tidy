# .clang-tidy - safety checks for zero-dependency systems C
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-implicit-bool-conversion,
  readability-isolate-declaration,
  readability-misleading-indentation,
  readability-magic-numbers,
  cppcoreguidelines-avoid-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-no-recursion,
  -hicpp-no-assembler,
  -hicpp-signed-bitwise,
  -readability-identifier-length,
  -readability-math-missing-parentheses,
  -cppcoreguidelines-init-variables,
  -altera-*,
  -google-readability-todo,
  -misc-include-cleaner,
  -misc-unused-parameters,
  -performance-no-int-to-ptr

# Treat these as errors - they catch real bugs
WarningsAsErrors: >
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cert-err33-c,
  cert-err34-c

CheckOptions:
  - key: bugprone-assert-side-effect.AssertMacros
    value: assert
  # Signed overflow is UB - we use unsigned everywhere
  - key: bugprone-narrowing-conversions.WarnOnIntegerNarrowingConversion
    value: true
  # Our functions should be small
  - key: readability-function-size.LineThreshold
    value: 100
  - key: readability-function-size.StatementThreshold
    value: 50
